# Environment configuration for the payroll_pipeline_prototype pipeline.
# Copy to .env and fill in real values. .env is gitignored.

# --- AWS ------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_PROFILE=
ENVIRONMENT=prod

# --- Data product ---------------------------------------------------------
DATA_PRODUCT=payroll_pipeline_prototype
DATA_BUCKET=

# --- Spark (local development) --------------------------------------------
SPARK_MASTER=local[*]
